<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CyberList"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="CyberList.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="/Styles/Palette.axaml" />
            <ResourceInclude Source="/Styles/FluentOverrides.axaml" />
        </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
</Application.Resources>
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#FF2B3D"
                                       RegionColor="#0B0D10" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <mi:MaterialIconStyles />
        <StyleInclude Source="/Styles/Hud.axaml" />
    </Application.Styles>
</Application>
