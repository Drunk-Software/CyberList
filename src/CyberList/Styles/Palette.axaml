<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Raw colors -->
    <Color x:Key="HudBackgroundColor">#0B0D10</Color>
    <Color x:Key="HudPanelColor">#14171B</Color>
    <Color x:Key="HudLineColor">#3A4048</Color>
    <Color x:Key="HudTextColor">#D8DDE3</Color>
    <Color x:Key="HudTextDimColor">#6B7480</Color>
    <Color x:Key="HudAccentColor">#FF2B3D</Color>
    <Color x:Key="HudWarnColor">#FFB020</Color>
    <Color x:Key="HudSuccessColor">#29C593</Color>

    <!-- Brushes (what controls actually use) -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="{StaticResource HudBackgroundColor}" />
    <SolidColorBrush x:Key="HudPanelBrush" Color="{StaticResource HudPanelColor}" />
    <SolidColorBrush x:Key="HudLineBrush" Color="{StaticResource HudLineColor}" />
    <SolidColorBrush x:Key="HudTextBrush" Color="{StaticResource HudTextColor}" />
    <SolidColorBrush x:Key="HudTextDimBrush" Color="{StaticResource HudTextDimColor}" />
    <SolidColorBrush x:Key="HudAccentBrush" Color="{StaticResource HudAccentColor}" />
    <SolidColorBrush x:Key="HudWarnBrush" Color="{StaticResource HudWarnColor}" />
    <SolidColorBrush x:Key="HudSuccessBrush" Color="{StaticResource HudSuccessColor}" />

    <!-- Playful extras: a second hot accent and a cool counter-color for the smudges -->
    <Color x:Key="HudAccent2Color">#FF2B8A</Color>
    <Color x:Key="HudCoolColor">#2BD9FF</Color>

    <!-- Window body: mostly-opaque dark glass with a faint red tint creeping into one corner.
         The alpha (first two hex digits, F0/E8...) lets the desktop show through a little. -->
    <LinearGradientBrush x:Key="HudBodyBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#F0111419" />
        <GradientStop Offset="0.6" Color="#E80B0D10" />
        <GradientStop Offset="1" Color="#F01C0A12" />
    </LinearGradientBrush>

    <!-- Inner panels: see-through so the smudges glow behind the list -->
    <SolidColorBrush x:Key="HudGlassPanelBrush" Color="#9914171B" />

    <!-- Header: red sliding into hot pink -->
    <LinearGradientBrush x:Key="HudHeaderBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="{StaticResource HudAccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource HudAccent2Color}" />
    </LinearGradientBrush>

    <!-- Color smudges: a color fading to fully transparent. The transparent stop keeps the same
         hue (#00FF2B3D, not #00000000) so the fade doesn't turn muddy grey at the edge. -->
    <RadialGradientBrush x:Key="HudSmudgeWarmBrush">
        <GradientStop Offset="0" Color="#55FF2B3D" />
        <GradientStop Offset="0.5" Color="#22FF2B8A" />
        <GradientStop Offset="1" Color="#00FF2B8A" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HudSmudgeCoolBrush">
        <GradientStop Offset="0" Color="#332BD9FF" />
        <GradientStop Offset="1" Color="#002BD9FF" />
    </RadialGradientBrush>

    <!-- Fonts -->
    <FontFamily x:Key="HudFont">avares://CyberList/Assets/Fonts#Chakra Petch</FontFamily>
    <FontFamily x:Key="HudMono">avares://CyberList/Assets/Fonts#Share Tech Mono</FontFamily>
</ResourceDictionary>