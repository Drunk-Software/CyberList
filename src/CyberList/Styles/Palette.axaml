<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Industrial HUD palette: flat charcoal greys, one hot red for alerts, a little amber.
         No gradients and no neon: contrast comes from the greys stepping up in brightness. -->

    <!-- Raw colors, darkest to brightest -->
    <Color x:Key="HudBackgroundColor">#111316</Color>   <!-- text fields, text on red/steel -->
    <Color x:Key="HudBodyColor">#17191C</Color>         <!-- the window slab -->
    <Color x:Key="HudPanelColor">#1C1F23</Color>        <!-- framed panels -->
    <Color x:Key="HudRaisedColor">#25292E</Color>       <!-- strips, buttons, hover -->
    <Color x:Key="HudLineColor">#34383E</Color>         <!-- frames, separators -->
    <Color x:Key="HudLineBrightColor">#4C5259</Color>   <!-- outer brackets, tree lines -->
    <Color x:Key="HudTextDimColor">#6E757E</Color>      <!-- labels, done text -->
    <Color x:Key="HudSteelColor">#C3C8CE</Color>        <!-- light grey: grey headers, barcode -->
    <Color x:Key="HudTextColor">#D9DDE2</Color>         <!-- main text -->
    <Color x:Key="HudAccentColor">#E3242F</Color>       <!-- red: header, alerts, "PENDING" -->
    <Color x:Key="HudWarnColor">#F2A20C</Color>         <!-- amber: tiny markers, "PARTIAL" -->
    <Color x:Key="HudSuccessColor">#C3C8CE</Color>      <!-- the reference has no green: steel instead -->

    <!-- Brushes (what controls actually use) -->
    <SolidColorBrush x:Key="HudBackgroundBrush" Color="{StaticResource HudBackgroundColor}" />
    <SolidColorBrush x:Key="HudBodyBrush" Color="{StaticResource HudBodyColor}" />
    <SolidColorBrush x:Key="HudPanelBrush" Color="{StaticResource HudPanelColor}" />
    <SolidColorBrush x:Key="HudRaisedBrush" Color="{StaticResource HudRaisedColor}" />
    <SolidColorBrush x:Key="HudLineBrush" Color="{StaticResource HudLineColor}" />
    <SolidColorBrush x:Key="HudLineBrightBrush" Color="{StaticResource HudLineBrightColor}" />
    <SolidColorBrush x:Key="HudTextDimBrush" Color="{StaticResource HudTextDimColor}" />
    <SolidColorBrush x:Key="HudSteelBrush" Color="{StaticResource HudSteelColor}" />
    <SolidColorBrush x:Key="HudTextBrush" Color="{StaticResource HudTextColor}" />
    <SolidColorBrush x:Key="HudAccentBrush" Color="{StaticResource HudAccentColor}" />
    <SolidColorBrush x:Key="HudWarnBrush" Color="{StaticResource HudWarnColor}" />
    <SolidColorBrush x:Key="HudSuccessBrush" Color="{StaticResource HudSuccessColor}" />

    <!-- Fonts -->
    <FontFamily x:Key="HudFont">avares://CyberList/Assets/Fonts#Chakra Petch</FontFamily>
    <FontFamily x:Key="HudMono">avares://CyberList/Assets/Fonts#Share Tech Mono</FontFamily>
</ResourceDictionary>
