<Window
    x:Class="CyberList.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:conv="using:CyberList.Converters"
    xmlns:vm="using:CyberList.ViewModels"
    xmlns:ctl="using:CyberList.Controls"
    x:Name="Root"
    Title="CyberList"
    Width="680"
    Height="840"
    MinWidth="480"
    MinHeight="420"
    d:DesignHeight="840"
    d:DesignWidth="680"
    FontSize="15"
    x:DataType="vm:MainWindowViewModel"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    Foreground="{StaticResource HudTextBrush}"
    FontFamily="{StaticResource HudFont}"
    WindowDecorations="BorderOnly"
    ExtendClientAreaToDecorationsHint="True"
    Padding="{Binding $self.OffScreenMargin}"
    Icon="/Assets/logo.ico"
    mc:Ignorable="d">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </Window.Resources>

    <Window.Styles>
        <!-- When maximized, drop the outer margin so the body fills the screen -->
        <Style Selector=":is(Window)[WindowState=Maximized] Grid.body-host">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Styles>

    <!-- Outer grid: the window is transparent; everything visible lives in body-host,
    and invisible resize grips sit on top along the outer (transparent) edges -->
    <Grid>
        <!-- Inset by 20px: room for the shadow and the outer bracket -->
        <Grid Classes="body-host" Margin="20">
            <!-- Outer bracket, 7px outside the body (negative margin = grow past our cell) -->
            <ctl:HudFrame Margin="-7" />
            <!-- The window shape itself: flat charcoa  l, chamfered bottom corners -->
            <ctl:CutBorder Classes="window-body" />
            <!-- Map-style dots and crosshairs, skipping the chamfers (same CutSize/Corners as window-body) -->
            <ctl:DotGrid CutSize="16" Corners="BottomLeft,BottomRight" />

            <Grid Margin="18,12,18,16" RowDefinitions="Auto,Auto,Auto,Auto,*">

                <!-- Row 0: top strip — filter tabs, a draggable gap, window buttons -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding PageTabs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageTab">
                                <RadioButton Classes="tab" GroupName="PageTabs"
                                             Theme="{StaticResource {x:Type ToggleButton}}"
                                             Content="{Binding Label}"
                                             IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The empty middle is the drag handle (Transparent, not null, so it gets the mouse) -->
                    <Panel Grid.Column="1" Background="Transparent"
                           WindowDecorationProperties.ElementRole="TitleBar">
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="SCENE" />
                            <TextBlock Classes="label alert" Text="{Binding CurrentNavItem.Number, FallbackValue=00}" />
                        </StackPanel>
                    </Panel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Shortcuts help: click, or press F1 anywhere -->
                        <Button x:Name="HelpButton" Classes="caption" ToolTip.Tip="Shortcuts (F1)">
                            <mi:MaterialIcon Kind="KeyboardOutline" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="hud">
                                    <StackPanel Spacing="10" Width="300">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="label bright" Text="SHORTCUTS" />
                                            <TextBlock Grid.Column="1" Classes="label" Text="F1" />
                                        </Grid>
                                        <Rectangle Height="1" Fill="{StaticResource HudLineBrush}" />

                                        <TextBlock Classes="label alert" Text="// SELECTED TASK" />
                                        <Grid Classes="keys" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                            <Border Grid.Row="0" Classes="key"><TextBlock Text="SPACE" /></Border>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Check / uncheck" />
                                            <Border Grid.Row="1" Classes="key"><TextBlock Text="E" /></Border>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Edit title" />
                                            <Border Grid.Row="2" Classes="key"><TextBlock Text="A" /></Border>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Add a sub-task" />
                                            <Border Grid.Row="3" Classes="key"><TextBlock Text="DEL" /></Border>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Delete (with its sub-tasks)" />
                                            <Border Grid.Row="4" Classes="key"><TextBlock Text="↑ ↓" /></Border>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Move between tasks" />
                                            <Border Grid.Row="5" Classes="key"><TextBlock Text="← →" /></Border>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Collapse / expand" />
                                        </Grid>

                                        <TextBlock Classes="label alert" Text="// TEXT FIELDS" />
                                        <Grid Classes="keys" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto">
                                            <Border Grid.Row="0" Classes="key"><TextBlock Text="ENTER" /></Border>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Add entry / save edit" />
                                            <Border Grid.Row="1" Classes="key"><TextBlock Text="ESC" /></Border>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Cancel edit" />
                                        </Grid>

                                        <TextBlock Classes="label alert" Text="// GENERAL" />
                                        <Grid Classes="keys" ColumnDefinitions="90,*" RowDefinitions="Auto">
                                            <Border Grid.Row="0" Classes="key"><TextBlock Text="TAB" /></Border>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Filters → new entry → tasks" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="caption" Click="OnMinimize"
                                WindowDecorationProperties.ElementRole="MinimizeButton">
                            <mi:MaterialIcon Kind="WindowMinimize" />
                        </Button>
                        <Button Classes="caption" Click="OnMaximize"
                                WindowDecorationProperties.ElementRole="MaximizeButton">
                            <mi:MaterialIcon x:Name="MaximizeIcon" Kind="WindowMaximize" />
                        </Button>
                        <Button Classes="caption close" Click="OnClose"
                                WindowDecorationProperties.ElementRole="CloseButton">
                            <mi:MaterialIcon Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: the red header bar. The title is the navigation toggle; the empty
                     space next to it stays a drag handle (double-click maximizes). The drag role
                     sits on that spacer only, so it can't swallow the toggle's clicks. -->
                <ctl:CutBorder Grid.Row="1" Classes="header">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <ToggleButton Classes="nav" IsChecked="{Binding IsNavOpen}"
                                      ToolTip.Tip="Navigate">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="h1"
                                           Text="{Binding CurrentNavItem.Title, StringFormat='CYBERLIST // {0}', FallbackValue='CYBERLIST'}" />
                                <mi:MaterialIcon Kind="ChevronDown" />
                            </StackPanel>
                        </ToggleButton>
                        <Panel Grid.Column="1" Background="Transparent"
                               WindowDecorationProperties.ElementRole="TitleBar" />
                        <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center"
                                   Margin="0,0,10,0" Text="/CL" />
                        <Rectangle Grid.Column="3" Width="7" Height="7"
                                   Fill="{StaticResource HudBackgroundBrush}" VerticalAlignment="Center" />
                    </Grid>
                </ctl:CutBorder>

                <!-- Row 2: navigation panel, expands under the header while the title is toggled on.
                     One Navigate command for every entry; the entry passes its page type. -->
                <Border Grid.Row="2" Classes="navpanel" IsVisible="{Binding IsNavOpen}">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Button Classes="hud navitem"
                                        Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                        CommandParameter="{Binding PageType}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Classes="number" Text="{Binding Number}" />
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Row 3: dark info strip under the header -->
                <Border Grid.Row="3" Classes="substrip">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="{Binding Today, StringFormat='DATE / {0}'}" />
                        <TextBlock Grid.Column="1" Classes="label" Text="{Binding DbName, StringFormat='NODE / {0}'}" />
                    </Grid>
                </Border>

                <!-- Row 4: the current page. The ViewLocator (App.axaml) picks its view by name -->
                <ContentControl Grid.Row="4" Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>

        <!-- Resize grips in the transparent 20px outer margin. Nearly-transparent (not null) so they
        receive the mouse; declared after the content so they sit on top. Corners last, so they
        win where they overlap the edges. -->
        <Border Classes="grip" Height="12" VerticalAlignment="Top"       WindowDecorationProperties.ElementRole="ResizeN" />
        <Border Classes="grip" Height="12" VerticalAlignment="Bottom"    WindowDecorationProperties.ElementRole="ResizeS" />
        <Border Classes="grip" Width="12"  HorizontalAlignment="Left"    WindowDecorationProperties.ElementRole="ResizeW" />
        <Border Classes="grip" Width="12"  HorizontalAlignment="Right"   WindowDecorationProperties.ElementRole="ResizeE" />
        <Border Classes="grip" Width="20" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Top"    WindowDecorationProperties.ElementRole="ResizeNW" />
        <Border Classes="grip" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"    WindowDecorationProperties.ElementRole="ResizeNE" />
        <Border Classes="grip" Width="20" Height="20" HorizontalAlignment="Left"  VerticalAlignment="Bottom" WindowDecorationProperties.ElementRole="ResizeSW" />
        <Border Classes="grip" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" WindowDecorationProperties.ElementRole="ResizeSE" />
    </Grid>
</Window>
