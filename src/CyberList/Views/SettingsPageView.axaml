<UserControl
    x:Class="CyberList.Views.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CyberList.ViewModels"
    xmlns:ctl="using:CyberList.Controls"
    x:DataType="vm:SettingsPageViewModel"
    d:DesignWidth="640"
    d:DesignHeight="600"
    mc:Ignorable="d">

    <!-- Placeholder: same panel frame as the list page, so switching pages keeps the layout -->
    <ctl:CutBorder Classes="panel" Margin="0,10,0,12">
        <TextBlock Classes="label empty" Text="SETTINGS // NOT IMPLEMENTED YET" />
    </ctl:CutBorder>
</UserControl>
