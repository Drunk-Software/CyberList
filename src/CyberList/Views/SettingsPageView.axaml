<UserControl
    x:Class="CyberList.Views.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:CyberList.ViewModels"
    xmlns:ctl="using:CyberList.Controls"
    x:DataType="vm:SettingsPageViewModel"
    d:DesignWidth="640"
    d:DesignHeight="600"
    mc:Ignorable="d">

    <UserControl.Styles>
        <!-- Block buttons here sit in rows, not in a stretched cell like the list's ADD -->
        <Style Selector="Button.hud">
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="TextBlock.label.field">
            <Setter Property="Width" Value="90" />
        </Style>
        <Style Selector="SelectableTextBlock.path">
            <Setter Property="FontFamily" Value="{StaticResource HudMono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource HudTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="SelectionBrush" Value="#66E3242F" />
        </Style>
        <!-- Banner / prompt box: a thin frame in the accent (warning) or steel (question) colour -->
        <Style Selector="Border.notice">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{StaticResource HudPanelBrush}" />
        </Style>
        <Style Selector="Border.notice.alert">
            <Setter Property="BorderBrush" Value="{StaticResource HudAccentBrush}" />
        </Style>
        <Style Selector="Border.notice.question">
            <Setter Property="BorderBrush" Value="{StaticResource HudWarnBrush}" />
        </Style>
    </UserControl.Styles>

    <ctl:CutBorder Classes="panel" Margin="0,10,0,12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,8,0">

                <!-- Section line: "DATABASE ———————— ▪▪" -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="label" Text="DATABASE" />
                    <Rectangle Grid.Column="1" Height="1" Margin="8,0" VerticalAlignment="Center"
                               Fill="{StaticResource HudLineBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                        <Rectangle Classes="amber" />
                        <Rectangle Classes="amber" />
                    </StackPanel>
                </Grid>

                <!-- The saved location was missing at startup -->
                <Border Classes="notice alert" IsVisible="{Binding HasStartupWarning}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="label alert" TextWrapping="Wrap" Text="{Binding StartupWarning}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="hud" Command="{Binding RetryLocationCommand}"
                                    Content="{mi:MaterialIconTextExt Kind=Refresh, Text=RETRY}" />
                            <Button Classes="hud" Command="{Binding KeepDefaultLocationCommand}"
                                    Content="{mi:MaterialIconTextExt Kind=Home, Text=KEEP DEFAULT}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Location: path + DEFAULT/CUSTOM tag -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="label field" Text="LOCATION" VerticalAlignment="Top" />
                    <SelectableTextBlock Grid.Column="1" Classes="path" Text="{Binding DatabasePath}" />
                    <TextBlock Grid.Column="2" Classes="label" Margin="12,0,0,0" VerticalAlignment="Top"
                               Classes.bright="{Binding !IsDefaultLocation}"
                               Text="{Binding LocationTag, StringFormat='[{0}]'}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="90,0,0,0">
                    <Button Classes="hud" Command="{Binding ChangeLocationCommand}"
                            Content="{mi:MaterialIconTextExt Kind=FolderMoveOutline, Text=CHANGE LOCATION…}" />
                    <Button Classes="hud" Command="{Binding ResetLocationCommand}"
                            Content="{mi:MaterialIconTextExt Kind=Restore, Text=RESET TO DEFAULT}" />
                </StackPanel>

                <!-- Backup: export / import -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="label field" Text="BACKUP" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="hud" Command="{Binding ExportCommand}"
                                Content="{mi:MaterialIconTextExt Kind=DatabaseExportOutline, Text=EXPORT…}" />
                        <Button Classes="hud" Command="{Binding ImportCommand}"
                                Content="{mi:MaterialIconTextExt Kind=DatabaseImportOutline, Text=IMPORT…}" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="label" Margin="90,0,0,0" TextWrapping="Wrap"
                           Text="IMPORT REPLACES ALL CURRENT DATA. THE CURRENT DATABASE IS BACKED UP FIRST." />

                <!-- A question waiting for an answer: its choices, then CANCEL -->
                <Border Classes="notice question" IsVisible="{Binding HasPrompt}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="label bright" TextWrapping="Wrap" Text="{Binding Prompt.Message}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ItemsControl ItemsSource="{Binding Prompt.Choices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PromptChoice">
                                        <Button Classes="hud" Content="{Binding Label}" Command="{Binding Command}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="hud" Content="CANCEL" Command="{Binding CancelPromptCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outcome of the last operation -->
                <TextBlock Classes="label bright" TextWrapping="Wrap"
                           Classes.alert="{Binding StatusIsError}"
                           Text="{Binding Status, StringFormat='&gt; {0}'}"
                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </ScrollViewer>
    </ctl:CutBorder>
</UserControl>
